{
  "name": "sui-tech-blog",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "start": "astro preview",
    "preview": "bun run build && bun run start",
    "astro": "astro",
    "deploy": "wrangler deploy --minify",
    "deploy:preview": "wrangler versions upload --minify",
    "dev:cf": "wrangler dev",
    "dev:cf:remote": "wrangler dev --remote",
    "cf-typegen": "wrangler types",
    "format": "biome format --write . && prettier --write '**/*.astro'",
    "format:check": "biome format . && prettier --check '**/*.astro'",
    "prettier": "prettier --write '**/*.astro'",
    "prettier:check": "prettier --check '**/*.astro'",
    "lint": "biome lint .",
    "lint:ai": "set -o pipefail && biome lint . --reporter=github 2>&1 | { grep '^::' || true; }",
    "lint:fix": "biome lint --write .",
    "lint:unsafe-fix": "biome lint --write --unsafe .",
    "type-check": "astro check && tsc --noEmit",
    "type-check:ai": "astro check && tsc --noEmit --pretty false",
    "astro-check": "astro check",
    "lhci:healthcheck": "lhci healthcheck",
    "lhci:astro": "bun run build && lhci collect --config=lighthouserc.json",
    "lhci:assert": "lhci assert --config=lighthouserc.json",
    "lhci:upload": "lhci upload --config=lighthouserc.json",
    "lhci:open": "lhci open",
    "textlint": "cd contents/ && bun run lint && cd ..",
    "textlint:fix": "cd contents/ && bun run lint:fix && cd ..",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:tags": "bun run scripts/check-tags.ts",
    "check:svg-security": "bun run scripts/check-svg-security.ts",
    "check:svg-security:all": "bun run scripts/check-svg-security.ts --all",
    "check:url-blank-lines": "bun run scripts/detect-url-without-blank-lines.ts",
    "fix:url-blank-lines": "bun run scripts/fix-url-blank-lines.ts --apply",
    "new-blog": "bun run scripts/create-blog-template.ts",
    "update-blog-icon": "bun run scripts/update-blog-icon.ts",
    "sync-icons": "bun run scripts/update-diagram-icons.ts",
    "ci": "biome ci .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "3.7.4",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "astro": "7.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "dompurify": "^3.4.5",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.577.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "2.4.15",
    "@lhci/cli": "^0.15.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/dompurify": "^3.2.0",
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.9.0",
    "beautiful-mermaid": "^1.1.3",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.33.0",
    "tailwindcss": "^4.3.0",
    "ts-morph": "^27.0.2",
    "tw-animate-css": "^1.4.0",
    "typed-query-selector": "^2.12.2",
    "typescript": "^5.9.3",
    "unicode-emoji-json": "^0.9.0",
    "wrangler": "^4.93.0"
  }
}
